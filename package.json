{
  "name": "hello-world",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "build:css": "tailwindcss -i ./src/styles/app.css -o ./dist/css/app.css --minify",
    "build:html": "node --env-file-if-exists=.env scripts/build.mjs",
    "build:assets": "node scripts/copy-assets.mjs",
    "build": "npm run clean && npm run build:css && npm run build:assets && npm run build:html",
    "preview": "npx --yes serve dist"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "pug": "^3.0.4",
    "tailwindcss": "^4.3.3"
  }
}
